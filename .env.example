# This example lists settings loaded from /.env by scripts/includes.sh.
# Process-only environment variables are documented in README.md.

# Actual Budget connection.
# Required for a successful backup.
ACTUAL_BUDGET_URL="https://actual.example.com"
ACTUAL_BUDGET_PASSWORD=""
ACTUAL_BUDGET_SYNC_ID=""

# Additional budgets.
# Numbered values must be consecutive. Parsing stops at the first missing value.
# ACTUAL_BUDGET_SYNC_ID_1=""
# ACTUAL_BUDGET_SYNC_ID_2=""

# End-to-end encrypted budgets.
# Use ACTUAL_BUDGET_E2E_PASSWORD for ACTUAL_BUDGET_SYNC_ID.
# Use ACTUAL_BUDGET_E2E_PASSWORD_N for ACTUAL_BUDGET_SYNC_ID_N.
# ACTUAL_BUDGET_E2E_PASSWORD=""
# ACTUAL_BUDGET_E2E_PASSWORD_1=""
# ACTUAL_BUDGET_E2E_PASSWORD_2=""

# Rclone destination.
RCLONE_REMOTE_NAME="ActualBudgetBackup"
RCLONE_REMOTE_DIR="/ActualBudgetBackup/"
RCLONE_GLOBAL_FLAG=""

# Additional rclone destinations.
# Numbered values must be consecutive. Parsing stops at the first missing name or dir.
# RCLONE_REMOTE_NAME_1="ExtraActualBudgetBackup"
# RCLONE_REMOTE_DIR_1="/ActualBudgetBackup/"
# RCLONE_REMOTE_NAME_2="AnotherActualBudgetBackup"
# RCLONE_REMOTE_DIR_2="/ActualBudgetBackup/"

# Schedule and retention.
CRON="0 0 * * *"
BACKUP_KEEP_DAYS="0"
BACKUP_FILE_SUFFIX="%Y%m%d"

# Legacy backup suffix pieces.
# Prefer BACKUP_FILE_SUFFIX for new configuration.
# BACKUP_FILE_DATE="%Y%m%d"
# BACKUP_FILE_DATE_SUFFIX=""

# Runtime.
TIMEZONE="UTC"
DISPLAY_NAME="Actual Budget"

# Telegram notifications.
# Notifications are enabled only when both TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_MESSAGE_THREAD_ID=""
TELEGRAM_PARSE_MODE=""
TELEGRAM_DISABLE_NOTIFICATION="FALSE"
TELEGRAM_WHEN_START="TRUE"
TELEGRAM_WHEN_SUCCESS="TRUE"
TELEGRAM_WHEN_FAILURE="TRUE"

# Secret files.
# The *_FILE form is supported for settings loaded by get_env in scripts/includes.sh.
# Examples:
# ACTUAL_BUDGET_PASSWORD_FILE="/run/secrets/actual-budget-password"
# TELEGRAM_BOT_TOKEN_FILE="/run/secrets/telegram-bot-token"
